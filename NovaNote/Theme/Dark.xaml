<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AppBgColor">#1B1B1B</Color>
    <Color x:Key="EditorBgColor">#202020</Color>
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="SubtleTextColor">#B5B5B5</Color>
    <Color x:Key="MenuHoverColor">#3A3A3A</Color>
    <Color x:Key="PopupBgColor">#2B2B2B</Color>
    <Color x:Key="PopupBorderColor">#141414</Color>
    <Color x:Key="PopupHoverColor">#393939</Color>
    <Color x:Key="AccentColor">#4CC2FF</Color>
    <Color x:Key="AccentFgColor">#000000</Color>
    <Color x:Key="WarnColor">#E0A03C</Color>
    <Color x:Key="SelectionColor">#594CC2FF</Color>
    <Color x:Key="DividerColor">#2E2E2E</Color>
    <Color x:Key="ButtonBgColor">#2C2C2C</Color>
    <Color x:Key="ButtonBorderColor">#1D1D1D</Color>
    <Color x:Key="ButtonHoverColor">#3A3A3A</Color>
    <Color x:Key="InputBgColor">#272727</Color>
    <Color x:Key="InputBorderColor">#4D4D4D</Color>
    <Color x:Key="ScrollThumbColor">#6F6F6F</Color>
    <Color x:Key="ScrollThumbHoverColor">#A8A8A8</Color>
    <Color x:Key="ListHoverColor">#353535</Color>
    <Color x:Key="TabActiveColor">#202020</Color>
    <Color x:Key="TabHoverColor">#2B2B2B</Color>

    <SolidColorBrush x:Key="AppBgBrush" Color="{DynamicResource AppBgColor}"/>
    <SolidColorBrush x:Key="EditorBgBrush" Color="{DynamicResource EditorBgColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="{DynamicResource SubtleTextColor}"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="{DynamicResource MenuHoverColor}"/>
    <SolidColorBrush x:Key="PopupBgBrush" Color="{DynamicResource PopupBgColor}"/>
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}"/>
    <SolidColorBrush x:Key="PopupHoverBrush" Color="{DynamicResource PopupHoverColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentFgBrush" Color="{DynamicResource AccentFgColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{DynamicResource WarnColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource DividerColor}"/>
    <SolidColorBrush x:Key="ButtonBgBrush" Color="{DynamicResource ButtonBgColor}"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource ButtonBorderColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{DynamicResource ButtonHoverColor}"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="{DynamicResource InputBgColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{DynamicResource InputBorderColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{DynamicResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{DynamicResource ScrollThumbHoverColor}"/>
    <SolidColorBrush x:Key="ListHoverBrush" Color="{DynamicResource ListHoverColor}"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="{DynamicResource TabActiveColor}"/>
    <SolidColorBrush x:Key="TabHoverBrush" Color="{DynamicResource TabHoverColor}"/>
    <SolidColorBrush x:Key="SyntaxStringBrush" Color="#CE9178"/>
    <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#B5CEA8"/>
    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#569CD6"/>
    <SolidColorBrush x:Key="SyntaxKeyBrush" Color="#9CDCFE"/>
    <SolidColorBrush x:Key="SyntaxPunctBrush" Color="#DCDCAA"/>
    <SolidColorBrush x:Key="SyntaxTagBrush" Color="#569CD6"/>
    <SolidColorBrush x:Key="SyntaxAttrBrush" Color="#9CDCFE"/>
    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#6A9955"/>
    <SolidColorBrush x:Key="SyntaxPreprocBrush" Color="#C586C0"/>
    <SolidColorBrush x:Key="SyntaxErrorBrush" Color="#FF5555"/>

</ResourceDictionary>
