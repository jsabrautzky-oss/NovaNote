<Window x:Class="NovaNote.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        Title="Über NovaNote" Width="480">
    <Grid Margin="20" MinWidth="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="NovaNote" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Grid.Row="1" x:Name="VersionText" Margin="0,6,0,0"
                   Foreground="{DynamicResource SubtleTextBrush}"/>
        <TextBlock Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrush}"
                   Text="WPF-Texteditor für Windows mit AvalonEdit, Themes (hell/dunkel/system), Mehrfach-Tabs, Syntax-Highlighting und Syntax-Check für JSON, XML, HTML, CSS, JavaScript und C++, Code-Folding, Encoding/EOL, Suchen/Ersetzen, Zoom, Drucken und Session-Wiederherstellung."/>
        <TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource SubtleTextBrush}">
            <Run Text="GitHub: "/>
            <Hyperlink NavigateUri="https://github.com/jsabrautzky-oss/NovaNote"
                       Foreground="{DynamicResource AccentBrush}"
                       RequestNavigate="GitHub_RequestNavigate">NovaNote Repo</Hyperlink>
            <Run Text=" · "/>
            <Hyperlink NavigateUri="https://github.com/jsabrautzky-oss/NovaNote/releases"
                       Foreground="{DynamicResource AccentBrush}"
                       RequestNavigate="GitHub_RequestNavigate">Releases</Hyperlink>
            <Run Text=" · "/>
            <Hyperlink NavigateUri="https://github.com/jsabrautzky-oss/NovaNote/blob/main/LICENSE"
                       Foreground="{DynamicResource AccentBrush}"
                       RequestNavigate="GitHub_RequestNavigate">MIT-Lizenz</Hyperlink>
        </TextBlock>
        <TextBlock Grid.Row="4" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource SubtleTextBrush}"
                   Text="© 2026 jsabrautzky-oss · MIT-Lizenz"/>
        <Button Grid.Row="5" Style="{StaticResource BtnAccent}" Content="OK" MinWidth="84"
                HorizontalAlignment="Right" Margin="0,18,0,0" IsDefault="True" IsCancel="True"/>
    </Grid>
</Window>
