<Window x:Class="NovaNote.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        Title="Suchen" Width="420">
    <Grid Margin="16" MinWidth="388">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Suchen:" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="SearchBox" Padding="6,4" MinHeight="26"
                 VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown"/>

        <Label x:Name="ReplaceLabel" Grid.Row="1" Grid.Column="0" Content="Ersetzen:"
               VerticalAlignment="Center" Margin="0,10,10,0"/>
        <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="1" Padding="6,4" MinHeight="26" Margin="0,10,0,0"
                 VerticalContentAlignment="Center" KeyDown="ReplaceBox_KeyDown"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <CheckBox x:Name="MatchCase" Content="Achte auf Groß-/Kleinschreibung"/>
            <CheckBox x:Name="WholeWord" Content="Nur ganzes Wort suchen" Margin="0,6,0,0"/>
            <CheckBox x:Name="Backward" Content="Rückwärts suchen" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="FindButton" Style="{StaticResource BtnAccent}" Content="Suchen"
                    IsDefault="True" MinWidth="84" Click="Find_Click"/>
            <Button x:Name="ReplaceButton" Style="{StaticResource Btn}" Content="Ersetzen"
                    MinWidth="84" Margin="8,0,0,0" Click="Replace_Click"/>
            <Button x:Name="ReplaceAllButton" Style="{StaticResource Btn}" Content="Alle ersetzen"
                    MinWidth="96" Margin="8,0,0,0" Click="ReplaceAll_Click"/>
        </StackPanel>

        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Btn}"
                Content="Schließen" MinWidth="84" HorizontalAlignment="Right" Margin="0,10,0,0"
                IsCancel="True" Click="Close_Click"/>
    </Grid>
</Window>
