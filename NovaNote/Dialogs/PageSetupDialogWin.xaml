<Window x:Class="NovaNote.PageSetupDialogWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        Title="Seiteneinrichtung" Width="360">
    <Grid Margin="16" MinWidth="328">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Label Content="Drucker:" Margin="0,0,0,2"/>
            <TextBox x:Name="PrinterBox" Padding="6,4" MinHeight="26" IsReadOnly="True"
                     VerticalContentAlignment="Center" Background="{DynamicResource InputBgBrush}"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Ränder (Zoll)" Margin="0,12,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="Links:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="2" x:Name="MargL" Padding="6,4" MinHeight="26" VerticalContentAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="0" Content="Oben:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="MargT" Padding="6,4" MinHeight="26" Margin="0,6,0,0" VerticalContentAlignment="Center"/>
                <Label Grid.Row="2" Grid.Column="0" Content="Rechts:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                <TextBox Grid.Row="2" Grid.Column="2" x:Name="MargR" Padding="6,4" MinHeight="26" Margin="0,6,0,0" VerticalContentAlignment="Center"/>
                <Label Grid.Row="3" Grid.Column="0" Content="Unten:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                <TextBox Grid.Row="3" Grid.Column="2" x:Name="MargB" Padding="6,4" MinHeight="26" Margin="0,6,0,0" VerticalContentAlignment="Center"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource BtnAccent}" Content="OK" MinWidth="84"
                    IsDefault="True" Click="Ok_Click"/>
            <Button Style="{StaticResource Btn}" Content="Abbrechen" MinWidth="84"
                    Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
