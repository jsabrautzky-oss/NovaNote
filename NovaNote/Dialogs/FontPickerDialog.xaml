<Window x:Class="NovaNote.FontPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        Title="Schriftart" Width="520" Height="460"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="0.7*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Schriftart:" Margin="0,0,0,4"/>
        <Label Grid.Row="0" Grid.Column="1" Content="Schriftstil:" Margin="8,0,0,4"/>
        <Label Grid.Row="0" Grid.Column="2" Content="Größe:" Margin="8,0,0,4"/>

        <ListBox Grid.Row="1" Grid.Column="0" x:Name="FamilyList" BorderThickness="1"
                 SelectionChanged="FamilyList_SelectionChanged" Padding="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        <ListBox Grid.Row="1" Grid.Column="1" x:Name="StyleList" BorderThickness="1" Margin="8,0,0,0"
                 SelectionChanged="StyleList_SelectionChanged" Padding="2"/>
        <ListBox Grid.Row="1" Grid.Column="2" x:Name="SizeList" BorderThickness="1" Margin="8,0,0,0"
                 SelectionChanged="SizeList_SelectionChanged" Padding="2" ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource InputBgBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                    CornerRadius="5" Height="72">
                <TextBlock x:Name="Preview" Margin="10,6" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                           Text="Aa Bb Cc Dd Ee – abcdefg – 0123456789"/>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Bottom">
                <Button Style="{StaticResource BtnAccent}" Content="OK" MinWidth="84"
                        IsDefault="True" Click="Ok_Click"/>
                <Button Style="{StaticResource Btn}" Content="Abbrechen" MinWidth="84"
                        Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
