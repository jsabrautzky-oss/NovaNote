<Window x:Class="NovaNote.FavoritesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        Title="Favoriten verwalten" Width="560" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14" MinWidth="460" MinHeight="320">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Favoriten:" Margin="0,0,0,4"/>
        <ListBox Grid.Row="1" Grid.Column="0" x:Name="FavoriteList" MinHeight="160"
                 SelectionChanged="FavoriteList_SelectionChanged" Margin="0,0,14,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="14" Height="14" Data="{StaticResource StarGeometry}"
                              Fill="{StaticResource StarGoldBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" Margin="6,0,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,10,14,0">
            <Button Style="{StaticResource Btn}" Content="Neu" MinWidth="72" Click="NewFavorite_Click"/>
            <Button Style="{StaticResource Btn}" x:Name="DeleteButton" Content="Löschen" MinWidth="72"
                    Margin="6,0,0,0" IsEnabled="False" Click="DeleteFavorite_Click"/>
        </StackPanel>

        <Label Grid.Row="0" Grid.Column="1" Content="Text:" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextEdit" AcceptsReturn="True" TextWrapping="Wrap"
                 Padding="6,4" MinHeight="160" VerticalScrollBarVisibility="Auto" IsEnabled="False"
                 TextChanged="TextEdit_TextChanged"/>
        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource Btn}" Content="Schließen"
                MinWidth="84" Margin="0,10,0,0" HorizontalAlignment="Right" Click="Close_Click"/>
    </Grid>
</Window>
