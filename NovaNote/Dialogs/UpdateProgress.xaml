<Window x:Class="NovaNote.UpdateProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        Title="NovaNote – Update" Width="360">
    <StackPanel Margin="16" MinWidth="328">
        <TextBlock x:Name="InfoText" TextWrapping="Wrap"/>
        <ProgressBar x:Name="Bar" Style="{StaticResource TokenBar}" Height="6"
                     Margin="0,12,0,6" Minimum="0" Maximum="100"/>
        <TextBlock x:Name="PercentText" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
