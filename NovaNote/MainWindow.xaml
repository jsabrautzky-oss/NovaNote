<Window x:Class="NovaNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NovaNote"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Unbenannt - NovaNote"
        Width="900" Height="640" MinWidth="420" MinHeight="260"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
        Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextBrush}"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
    <Window.Resources>
        <DataTemplate x:Key="FavoriteItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <Path Width="16" Height="16" Data="{StaticResource StarGeometry}" Fill="{StaticResource StarGoldBrush}"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="6,2,0,0"
                           Cursor="Hand" MouseLeftButtonUp="PopupInsert_Click"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="HistoryItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <Button Style="{StaticResource IconBtn}" VerticalAlignment="Top"
                        Click="HistoryStar_Click" ToolTip="Zu Favoriten hinzufügen / entfernen">
                    <Grid Width="16" Height="16">
                        <Path x:Name="StarOutline" Data="{StaticResource StarGeometry}"
                              Stroke="{DynamicResource SubtleTextBrush}" StrokeThickness="1.2" Fill="Transparent"/>
                        <Path x:Name="StarFill" Data="{StaticResource StarGeometry}"
                              Fill="{StaticResource StarGoldBrush}" Visibility="Collapsed"/>
                    </Grid>
                </Button>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="6,2,0,0"
                           Cursor="Hand" MouseLeftButtonUp="PopupInsert_Click"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Favorite}" Value="True">
                    <Setter TargetName="StarOutline" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="StarFill" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="TabContentTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x25CF;" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="10,0,4,0" ToolTip="Ungespeicherte Änderungen">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Hidden"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Dirty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Tip}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <Button Grid.Column="2" Style="{StaticResource TabCloseButton}" Content="&#xE8BB;"
                        Command="{x:Static local:Commands.CloseTab}" CommandParameter="{Binding}"
                        ToolTip="Tab schließen" Margin="0,0,6,0"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="0"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="MenuBarRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Menu Grid.Column="0" x:Name="MainMenu">
            <MenuItem Header="Datei">
                <MenuItem x:Name="FileNewTabItem" Header="Neuer Tab" InputGestureText="Strg+T" Click="NewTab_Click"/>
                <MenuItem x:Name="FileOpenItem" Header="Öffnen…" InputGestureText="Strg+O" Click="OpenTab_Click"/>
                <Separator/>
                <MenuItem x:Name="FileSaveItem" Header="Speichern" InputGestureText="Strg+S" Click="FileSave_Click"/>
                <MenuItem x:Name="FileSaveAsItem" Header="Speichern unter…" InputGestureText="Strg+Umschalt+S" Click="FileSaveAs_Click"/>
                <Separator/>
                <MenuItem x:Name="FilePageSetupItem" Header="Seiteneinrichtung…" Click="PageSetup_Click"/>
                <MenuItem x:Name="FilePrintItem" Header="Drucken…" InputGestureText="Strg+P" Click="Print_Click"/>
                <Separator/>
                <MenuItem x:Name="TabCloseItem" Header="Tab schließen" InputGestureText="Strg+W" Click="TabClose_Click"/>
                <MenuItem x:Name="TabRestoreItem" Header="Zuletzt geschlossenen Tab öffnen" InputGestureText="Strg+Umschalt+T" IsEnabled="False" Click="TabRestore_Click"/>
                <MenuItem x:Name="TabCloseAllItem" Header="Alle Tabs schließen" InputGestureText="Strg+Umschalt+W" Click="TabCloseAll_Click"/>
                <Separator/>
                <MenuItem x:Name="AskSaveOnCloseItem" Header="Vor dem Schließen nach Speichern fragen"
                          IsCheckable="True" IsChecked="True" Click="AskSaveOnClose_Click"
                          ToolTip="Ausgeschaltet verwirft „Beenden“ offene Änderungen ohne Dialog (praktisch zum Testen)."/>
                <MenuItem x:Name="FileExitItem" Header="Beenden" InputGestureText="Alt+F4" Click="FileExit_Click"/>
            </MenuItem>

            <MenuItem Header="Bearbeiten">
                <MenuItem x:Name="EditUndoItem" Header="Rückgängig" InputGestureText="Strg+Z" Click="EditUndo_Click"/>
                <MenuItem x:Name="EditRedoItem" Header="Wiederholen" InputGestureText="Strg+Y" Click="EditRedo_Click"/>
                <Separator/>
                <MenuItem x:Name="EditCutItem" Header="Ausschneiden" InputGestureText="Strg+X" Click="EditCut_Click"/>
                <MenuItem x:Name="EditCopyItem" Header="Kopieren" InputGestureText="Strg+C" Click="EditCopy_Click"/>
                <MenuItem x:Name="EditPasteItem" Header="Einfügen" InputGestureText="Strg+V" Click="EditPaste_Click"/>
                <MenuItem x:Name="EditDeleteItem" Header="Löschen" InputGestureText="Entf" Click="EditDelete_Click"/>
                <Separator/>
                <MenuItem x:Name="EditFindItem" Header="Suchen…" InputGestureText="Strg+F" Click="EditFind_Click"/>
                <MenuItem x:Name="EditFindNextItem" Header="Weitersuchen" InputGestureText="F3" Click="EditFindNext_Click"/>
                <MenuItem x:Name="EditFindPrevItem" Header="Rückwärtssuchen" InputGestureText="Umschalt+F3" Click="EditFindPrev_Click"/>
                <MenuItem x:Name="EditReplaceItem" Header="Ersetzen…" InputGestureText="Strg+H" Click="EditReplace_Click"/>
                <MenuItem x:Name="EditGotoItem" Header="Gehe zu Zeile…" InputGestureText="Strg+G" Click="EditGoto_Click"/>
                <Separator/>
                <MenuItem x:Name="EditSelectAllItem" Header="Alles markieren" InputGestureText="Strg+A" Click="EditSelectAll_Click"/>
                <MenuItem x:Name="EditDateTimeItem" Header="Uhrzeit und Datum" InputGestureText="F5" Click="EditDateTime_Click"/>
            </MenuItem>

            <MenuItem Header="Format">
                <MenuItem x:Name="FormatWrapItem" Header="Zeilenumbruch" IsChecked="True" IsCheckable="True" Click="FormatWrap_Click"/>
                <MenuItem x:Name="FormatFontItem" Header="Schriftart…" Click="FormatFont_Click"/>
                <Separator/>
                <MenuItem Header="Kodierung">
                    <MenuItem x:Name="EncUtf8Item" Header="UTF-8" IsCheckable="True" IsChecked="True" Click="Encoding_Click" Tag="Utf8"/>
                    <MenuItem x:Name="EncUtf8BomItem" Header="UTF-8 mit BOM" IsCheckable="True" Click="Encoding_Click" Tag="Utf8Bom"/>
                    <MenuItem x:Name="EncUtf16LeItem" Header="UTF-16 LE" IsCheckable="True" Click="Encoding_Click" Tag="Utf16Le"/>
                    <MenuItem x:Name="EncUtf16BeItem" Header="UTF-16 BE" IsCheckable="True" Click="Encoding_Click" Tag="Utf16Be"/>
                    <MenuItem x:Name="EncAnsiItem" Header="ANSI" IsCheckable="True" Click="Encoding_Click" Tag="Ansi"/>
                </MenuItem>
                <MenuItem Header="Zeilenenden">
                    <MenuItem x:Name="EolCrLfItem" Header="Windows (CRLF)" IsCheckable="True" IsChecked="True" Click="Eol_Click" Tag="CrLf"/>
                    <MenuItem x:Name="EolLfItem" Header="Unix (LF)" IsCheckable="True" Click="Eol_Click" Tag="Lf"/>
                    <MenuItem x:Name="EolCrItem" Header="Macintosh (CR)" IsCheckable="True" Click="Eol_Click" Tag="Cr"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Ansicht">
                <MenuItem x:Name="TabDetachItem" Header="Tab in neues Fenster verschieben" InputGestureText="Strg+Umschalt+D" Click="TabDetach_Click"/>
                <MenuItem Header="Tabs">
                    <MenuItem x:Name="TabModeItem" Header="Multi-Tab-Modus" IsCheckable="True" IsChecked="True" Click="TabMode_Click"/>
                    <MenuItem x:Name="SessionRestoreItem" Header="Tabs beim Start wiederherstellen" IsCheckable="True" IsChecked="True" Click="SessionRestore_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="ViewZoomInItem" Header="Vergrößern" InputGestureText="Strg+Plus" Click="ZoomIn_Click"/>
                <MenuItem x:Name="ViewZoomOutItem" Header="Verkleinern" InputGestureText="Strg+Minus" Click="ZoomOut_Click"/>
                <MenuItem x:Name="ViewZoomResetItem" Header="Standardgröße" InputGestureText="Strg+0" Click="ZoomReset_Click"/>
                <Separator/>
                <MenuItem x:Name="ViewStatusBarItem" Header="Statusleiste" IsChecked="True" IsCheckable="True" Click="StatusBar_Click"/>
                <MenuItem x:Name="ViewLineNumbersItem" Header="Zeilennummern" IsCheckable="True" IsChecked="True" Click="ViewLineNumbers_Click"/>
                <MenuItem x:Name="ViewWhitespaceItem" Header="Whitespace anzeigen" IsCheckable="True" IsChecked="True" Click="ViewWhitespace_Click"/>
                <MenuItem x:Name="SyntaxCheckItem" Header="Syntax-Check" IsCheckable="True" IsChecked="True" Click="SyntaxCheck_Click"/>
                <MenuItem x:Name="FoldingItem" Header="Code-Folding" IsCheckable="True" IsChecked="True" Click="Folding_Click"/>
                <MenuItem x:Name="SyntaxNextItem" Header="Nächster Syntaxfehler" InputGestureText="F4" IsEnabled="False" Click="SyntaxNext_Click"/>
                <Separator/>
                <MenuItem Header="Farbschema">
                    <MenuItem x:Name="ThemeLightItem" Header="Hell" IsCheckable="True" Click="Theme_Click" Tag="hell"/>
                    <MenuItem x:Name="ThemeDarkItem" Header="Dunkel" IsCheckable="True" Click="Theme_Click" Tag="dunkel"/>
                    <MenuItem x:Name="ThemeSystemItem" Header="System" IsCheckable="True" IsChecked="True" Click="Theme_Click" Tag="system"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Sprachen">
                    <MenuItem x:Name="LangAutoItem" Header="Automatisch erkennen" IsCheckable="True" IsChecked="True" Click="LangAuto_Click"/>
                    <Separator/>
                    <MenuItem x:Name="LangJsonFormatItem" Header="JSON formatieren" InputGestureText="Strg+Umschalt+J" Click="LangJsonFormat_Click"/>
                    <MenuItem x:Name="CodeFormatItem" Header="Code formatieren" InputGestureText="Strg+Umschalt+F" IsEnabled="False" Click="CodeFormat_Click"/>
                    <MenuItem x:Name="PythonCompletionItem" Header="Python-Completion" InputGestureText="Strg+Leertaste" IsEnabled="False" Click="PythonCompletion_Click"/>
                    <Separator/>
                    <MenuItem x:Name="LangNoneItem" Header="Text" IsCheckable="True" Click="Language_Click" Tag="None"/>
                    <MenuItem x:Name="LangJsonItem" Header="JSON" IsCheckable="True" Click="Language_Click" Tag="Json"/>
                    <MenuItem x:Name="LangXmlItem" Header="XML" IsCheckable="True" Click="Language_Click" Tag="Xml"/>
                    <MenuItem x:Name="LangHtmlItem" Header="HTML" IsCheckable="True" Click="Language_Click" Tag="Html"/>
                    <MenuItem x:Name="LangCssItem" Header="CSS" IsCheckable="True" Click="Language_Click" Tag="Css"/>
                    <MenuItem x:Name="LangJsItem" Header="JavaScript" IsCheckable="True" Click="Language_Click" Tag="JavaScript"/>
                    <MenuItem x:Name="LangCppItem" Header="C++" IsCheckable="True" Click="Language_Click" Tag="Cpp"/>
                    <MenuItem x:Name="LangMarkdownItem" Header="Markdown" IsCheckable="True" Click="Language_Click" Tag="Markdown"/>
                    <MenuItem x:Name="LangPythonItem" Header="Python" IsCheckable="True" Click="Language_Click" Tag="Python"/>
                    <MenuItem x:Name="LangCSharpItem" Header="C#" IsCheckable="True" Click="Language_Click" Tag="CSharp"/>
                    <MenuItem x:Name="LangYamlItem" Header="YAML" IsCheckable="True" Click="Language_Click" Tag="Yaml"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="KI">
                <MenuItem x:Name="AiPanelItem" Header="KI-Panel" InputGestureText="Strg+Alt+K"
                          IsCheckable="True" IsChecked="False" Click="AiPanel_Click"/>
                <Separator/>
                <MenuItem x:Name="AiScanItem" Header="Modelle scannen" Click="AiScan_Click"/>
                <MenuItem x:Name="AiSettingsItem" Header="KI-Einstellungen…" Click="AiSettings_Click"/>
            </MenuItem>

            <MenuItem Header="Hilfe">
                <MenuItem Header="Update">
                    <MenuItem x:Name="UpdateAutoItem" Header="Automatisch auf Updates prüfen"
                             IsCheckable="True" IsChecked="True" Click="UpdateAuto_Click"/>
                    <Separator/>
                    <MenuItem x:Name="UpdateNowItem" Header="Nach Update prüfen" Click="UpdateNow_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="DebugLogItem" Header="Debug-Log" IsCheckable="True"
                          ToolTip="Alle Aktionen, der komplette KI-Chat (Eingaben, Antworten, Tool-Aufrufe) und Fehler werden mit Zeitstempel in debug.log mitschrieben"
                          Click="DebugLog_Click"/>
                <MenuItem x:Name="DebugLogOpenItem" Header="Debug-Log öffnen" Click="DebugLogOpen_Click"/>
                <Separator/>
                <MenuItem x:Name="HelpAboutItem" Header="Über NovaNote" Click="HelpAbout_Click"/>
            </MenuItem>
                </Menu>
                <ToggleButton Grid.Column="1" x:Name="AiToggle" Style="{StaticResource ToggleBtn}"
                              Content="&#xE8BD;" ToolTip="KI-Panel (Strg+Alt+K)"
                              Checked="AiToggle_Checked" Unchecked="AiToggle_Unchecked"/>
            </Grid>

            <Grid Grid.Row="1" x:Name="TabStripRow" Background="{DynamicResource AppBgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0" x:Name="TabStrip" Style="{StaticResource TabListStyle}"
                     ItemTemplate="{StaticResource TabContentTemplate}"
                     ItemContainerStyle="{StaticResource TabItemStyle}"
                     AllowDrop="True" DragOver="TabStrip_DragOver" Drop="TabStrip_Drop"
                     PreviewMouseLeftButtonDown="TabStrip_Down" PreviewMouseMove="TabStrip_Move"
                     SelectionChanged="TabStrip_SelectionChanged"/>
            <Button Grid.Column="1" x:Name="PlusTabButton" Style="{StaticResource PlusTabButton}"
                    Content="&#xE710;" ToolTip="Neuer Tab" Click="NewTab_Click"/>
            <Border Grid.Column="0" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                    Background="{DynamicResource DividerBrush}"/>
        </Grid>

        <ContentControl Grid.Row="2" x:Name="EditorHost" Focusable="False"/>

        <Border Grid.Row="3" Background="{DynamicResource AppBgBrush}" Padding="12,6"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid x:Name="StatusBarGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusCaret" Grid.Column="0" Text="Zeile 1, Spalte 1"
                           Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusSelection" Grid.Column="1" Text=""
                           Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusSyntax" Grid.Column="2" Text=""
                           Foreground="{DynamicResource SubtleTextBrush}" Margin="6,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"
                           Cursor="Hand" MouseLeftButtonUp="StatusSyntax_Click"
                           ToolTip="Klick: Syntax-Check an/aus schalten"/>
                <TextBlock x:Name="StatusLanguage" Grid.Column="3" Text="Text" HorizontalAlignment="Right"
                           Foreground="{DynamicResource SubtleTextBrush}" Margin="12,0" VerticalAlignment="Center"
                           Cursor="Hand" MouseLeftButtonUp="StatusLanguage_Click"
                           ToolTip="Klick: Sprache wählen (manuelle Auswahl schaltet „Automatisch erkennen“ aus)"/>
                <TextBlock x:Name="StatusEncoding" Grid.Column="4" Text="UTF-8"
                           Foreground="{DynamicResource SubtleTextBrush}" Margin="12,0" VerticalAlignment="Center"
                           Cursor="Hand" MouseLeftButtonUp="StatusEncoding_Click"
                           ToolTip="Klick: Encoding wählen"/>
                <TextBlock x:Name="StatusEol" Grid.Column="5" Text="Windows (CRLF)"
                           Foreground="{DynamicResource SubtleTextBrush}" Margin="12,0" VerticalAlignment="Center"
                           Cursor="Hand" MouseLeftButtonUp="StatusEol_Click"
                           ToolTip="Klick: Zeilenende wählen"/>
                <TextBlock x:Name="StatusZoom" Grid.Column="6" Text="100 %"
                           Foreground="{DynamicResource SubtleTextBrush}" Margin="12,0" VerticalAlignment="Center"
                           Cursor="Hand" MouseLeftButtonUp="StatusZoom_Click"
                           ToolTip="Klick: Schriftgröße mit Schieberegler ändern"/>
                <Popup x:Name="ZoomPopup" PlacementTarget="{Binding ElementName=StatusZoom}"
                       Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{DynamicResource PopupBgBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" MinWidth="220">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.30" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="ZoomSlider" Width="180" Minimum="40" Maximum="300"
                                    TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="ZoomSlider_Changed"/>
                            <TextBlock x:Name="ZoomSliderValue" Text="100 %" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        </Grid>

        <GridSplitter Grid.Column="1" x:Name="AiSplitter" Visibility="Collapsed" Width="4"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{DynamicResource DividerBrush}" ResizeBehavior="PreviousAndNext"
                      DragCompleted="AiSplitter_DragCompleted"/>

        <Border Grid.Column="2" x:Name="AiPanel" Visibility="Collapsed" MinWidth="180" MaxWidth="720"
                Background="{DynamicResource AppBgBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="AiProviderBox" Margin="0,0,6,0" ToolTip="Anbieter"
                              SelectionChanged="AiProviderBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Column="1" x:Name="AiModelBox" ToolTip="Modell"
                              SelectionChanged="AiModelBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Column="2" x:Name="AiReasoningBox" Width="112" Margin="6,0,0,0"
                              ToolTip="Denktiefe (reasoning_effort) – gilt für alle Nachrichten; „Modell-Standard“ nutzt die Vorgabe aus KI → KI-Einstellungen… Kein Wert wird gesendet, wenn dort auch nichts gesetzt ist."
                              SelectionChanged="AiReasoningBox_SelectionChanged"/>
                </Grid>

                <TextBlock Grid.Row="1" x:Name="AiStatus" Margin="0,8,0,6" Text="KI bereit"
                           Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>

                <Grid Grid.Row="2" MinHeight="120">
                    <wv:WebView2 x:Name="AiChat" Visibility="Collapsed"/>
                    <TextBox x:Name="AiLog" IsReadOnly="True" TextWrapping="Wrap" MinHeight="120"
                             Padding="6,4" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}"
                             Background="{DynamicResource EditorBgBrush}" VerticalScrollBarVisibility="Auto"
                             Visibility="Collapsed"/>
                </Grid>

                <ItemsControl Grid.Row="3" x:Name="AiAttachStrip" Margin="0,6,0,0" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,6,6" Padding="4" CornerRadius="4"
                                    Background="{DynamicResource EditorBgBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="48" Height="48">
                                        <TextBlock Text="Bild" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SubtleTextBrush}"/>
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                    </Grid>
                                    <TextBlock Text="{Binding FileName}" MaxWidth="110" Margin="6,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Note}"/>
                                    <Button Content="&#10005;" Style="{StaticResource Btn}" MinWidth="24"
                                            Margin="6,0,0,0" Click="AiAttachRemove_Click" Tag="{Binding}"
                                            ToolTip="Bild entfernen"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="4" x:Name="AiInputRow" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="AiInput" AcceptsReturn="True" TextWrapping="Wrap"
                             Padding="6,4" MinHeight="64" MaxHeight="138"
                             VerticalScrollBarVisibility="Auto" AllowDrop="True"
                             DragEnter="AiInput_DragEnter" DragLeave="AiInput_DragLeave" Drop="AiInput_Drop"
                             PreviewKeyDown="AiInput_PreviewKeyDown"/>
                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" Margin="6,0,0,0">
                        <Button x:Name="AiFavoritesPopupButton" Style="{StaticResource IconBtn}" Margin="0,0,0,4"
                                ToolTip="Favoriten anzeigen" Click="AiFavoritesPopup_Click">
                            <Grid Width="16" Height="16">
                                <Path Data="{StaticResource StarGeometry}" Stroke="{DynamicResource SubtleTextBrush}"
                                      StrokeThickness="1.2" Fill="Transparent"/>
                            </Grid>
                        </Button>
                        <Button x:Name="AiHistoryPopupButton" Style="{StaticResource IconBtn}" Margin="0,0,0,4"
                                ToolTip="Die letzten 10 Eingaben" Click="AiHistoryPopup_Click">
                            <Grid Width="16" Height="16">
                                <Path Data="M2.5,4.5 L13.5,4.5 M2.5,8 L13.5,8 M2.5,11.5 L13.5,11.5"
                                      Stroke="{DynamicResource SubtleTextBrush}" StrokeThickness="1.4"/>
                            </Grid>
                        </Button>
                        <Button x:Name="AiManageButton" Style="{StaticResource IconBtn}"
                                ToolTip="Favoriten verwalten" Click="AiFavoritesManage_Click">
                            <Grid Width="16" Height="16">
                                <Path Data="{StaticResource GearGeometry}" Stroke="{DynamicResource SubtleTextBrush}"
                                      StrokeThickness="1.2" Fill="Transparent"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <Popup x:Name="AiFavoritesPopup" PlacementTarget="{Binding ElementName=AiInputRow}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource PopupBgBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10,8" MinWidth="240"
                                Width="{Binding ActualWidth, ElementName=AiInputRow}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.30" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Favoriten" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,4"/>
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="FavoritesItems" ItemTemplate="{StaticResource FavoriteItemTemplate}"/>
                                </ScrollViewer>
                                <TextBlock x:Name="FavoritesEmptyHint" Text="Noch keine Favoriten."
                                           Foreground="{DynamicResource SubtleTextBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="AiHistoryPopup" PlacementTarget="{Binding ElementName=AiInputRow}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource PopupBgBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10,8" MinWidth="240"
                                Width="{Binding ActualWidth, ElementName=AiInputRow}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.30" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Eingaben" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,4"/>
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="HistoryItems" ItemTemplate="{StaticResource HistoryItemTemplate}"/>
                                </ScrollViewer>
                                <TextBlock x:Name="HistoryEmptyHint" Text="Noch keine Eingaben."
                                           Foreground="{DynamicResource SubtleTextBrush}" Visibility="Collapsed"/>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,6"/>
                                <Button Style="{StaticResource Btn}" Content="Verlauf leeren" MinWidth="96"
                                        HorizontalAlignment="Left" Click="AiHistoryClear_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <WrapPanel Grid.Row="5" Margin="0,8,0,0">
                    <Button x:Name="AiAttachButton" Style="{StaticResource Btn}" Content="+" MinWidth="34"
                            ToolTip="Bild anhängen" Click="AiAttach_Click"/>
                    <Button x:Name="AiSendButton" Style="{StaticResource BtnAccent}" Content="Senden"
                            MinWidth="90" Margin="6,0,0,0" Click="AiSend_Click"/>
                    <Button x:Name="AiCancelButton" Style="{StaticResource Btn}" Content="Abbrechen"
                            MinWidth="80" Margin="6,0,0,0" Visibility="Collapsed" Click="AiCancel_Click"/>
                    <Button x:Name="AiClearButton" Style="{StaticResource Btn}" Content="Verlauf löschen"
                            MinWidth="100" Margin="6,0,0,0" Click="AiClear_Click"/>
                </WrapPanel>

                <Border Grid.Row="6" Margin="0,8,0,0" Padding="8,5" SnapsToDevicePixels="True"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AiTokenText" Grid.Column="0" Text="Kontext –" MinWidth="116"
                                   Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="AiTokenBar" Grid.Column="1" Style="{StaticResource TokenBar}"
                                     MinWidth="60" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AiTokenMode" Grid.Column="2" Text="0 %" MinWidth="52"
                                   Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
