<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NovaNote</RootNamespace>
    <AssemblyName>NovaNote</AssemblyName>
    <StartupObject>NovaNote.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>novanote.ico</ApplicationIcon>
    <VersionPrefix>0.5.1</VersionPrefix>
    <Version>0.5.1</Version>
    <AssemblyVersion>0.5.1.0</AssemblyVersion>
    <FileVersion>0.5.1.0</FileVersion>
    <UseWindowsForms>false</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Acornima" Version="1.9.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="MdXaml" Version="1.27.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.11" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Highlighting\Json.xshd" LogicalName="NovaNote.Highlighting.Json.xshd" />
    <EmbeddedResource Include="Highlighting\Markdown.xshd" LogicalName="NovaNote.Highlighting.Markdown.xshd" />
    <EmbeddedResource Include="Highlighting\Yaml.xshd" LogicalName="NovaNote.Highlighting.Yaml.xshd" />
  </ItemGroup>

</Project>
