<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NovaNote</RootNamespace>
    <AssemblyName>NovaNote</AssemblyName>
    <StartupObject>NovaNote.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>novanote.ico</ApplicationIcon>
    <VersionPrefix>0.8.1</VersionPrefix>
    <Version>0.8.1</Version>
    <AssemblyVersion>0.8.1.0</AssemblyVersion>
    <FileVersion>0.8.1.0</FileVersion>
    <UseWindowsForms>false</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Acornima" Version="1.9.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="MdXaml" Version="1.27.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
        <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.11" />
        <PackageReference Include="Tiktoken.Core" Version="3.1.5" />
        <PackageReference Include="Tiktoken.Encodings.cl100k" Version="3.1.5" />
        <PackageReference Include="Tiktoken.Encodings.o200k" Version="3.1.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.11" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Chat\chat.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Chat\chat.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Chat\chat.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Chat\marked.min.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Chat\highlight.min.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Highlighting\Json.xshd" LogicalName="NovaNote.Highlighting.Json.xshd" />
    <EmbeddedResource Include="Highlighting\Markdown.xshd" LogicalName="NovaNote.Highlighting.Markdown.xshd" />
    <EmbeddedResource Include="Highlighting\Yaml.xshd" LogicalName="NovaNote.Highlighting.Yaml.xshd" />
    <EmbeddedResource Include="Assets\Help\hilfe.md" LogicalName="NovaNote.Help.hilfe.md" />
  </ItemGroup>

</Project>
